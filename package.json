{
    "name": "temp",
    "version": "1.0.0",
    "main": "index.js",
    "license": "ISC",
    "scripts": {
        "dev": "npx dotenv-cli -e .env -- ts-node-dev -r tsconfig-paths/register --inspect --transpile-only --ignore-watch node_modules src/common/infrastructure/http/server.ts",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier . --write",
        "teste": "dotenv-cli -e .env.test -- jest --runInBand",
        "typeorm": "ts-node-dev -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
        "pretest:int": "docker run --name testsdb -e POSTGRES_PASSWORD=postgres -p 5433:5432 -d postgres",
        "test:int": "npx dotenv-cli -e .env.test -- jest --runInBand --config ./jest.int.config.cjs",
        "posttest:int": "docker stop testsdb && docker rm testsdb"
    },
    "prettier": {
        "semi": true,
        "tabWidth": 4,
        "trailingComma": "all",
        "singleQuote": true,
        "printWidth": 80,
        "arrowParens": "avoid",
        "endOfLine": "auto"
    },
    "dependencies": {
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "dotenv-cli": "^8.0.0",
        "express": "^4.19.2",
        "express-async-errors": "^3.1.1",
        "pg": "^8.12.0",
        "reflect-metadata": "^0.2.2",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.1",
        "typeorm": "^0.3.23",
        "zod": "^3.24.3"
    },
    "devDependencies": {
        "@eslint/js": "^9.9.0",
        "@faker-js/faker": "^9.9.0",
        "@jest/globals": "^30.0.4",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jest": "^30.0.0",
        "@types/node": "^22.3.0",
        "@types/swagger-jsdoc": "^6.0.4",
        "@types/swagger-ui-express": "^4.1.8",
        "eslint": "^9.9.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.2.1",
        "globals": "^15.9.0",
        "jest": "^30.0.5",
        "prettier": "^3.3.3",
        "ts-jest": "^29.4.9",
        "ts-node-dev": "^2.0.0",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.1.0"
    }
}